# ------------------------------
# Backend environment variables
# ------------------------------

# Database (required)
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/DATABASE_NAME"

# JWT (required)
JWT_SECRET="REPLACE_WITH_A_LONG_RANDOM_SECRET"
JWT_EXPIRATION="7d"

# Exchange rate provider (required)
EXCHANGE_RATE_API_KEY="REPLACE_WITH_EXCHANGERATEAPI_KEY"
EXCHANGE_RATE_API_URL="https://v6.exchangerate-api.com/v6"

# Stripe (optional for MVP, required when billing is enabled)
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PREMIUM_PRICE_ID=""

# Email SMTP (required for reset-password and notifications)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-smtp-user@example.com"
SMTP_PASSWORD="your-smtp-password-or-app-password"
EMAIL_FROM="XChange <noreply@yourdomain.com>"

# App runtime (required)
PORT=3001
NODE_ENV="production"
FRONTEND_URL="https://app.yourdomain.com"

# Rate limiting (recommended)
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# Cron (optional but recommended)
ENABLE_RATE_UPDATES="true"
RATE_UPDATE_INTERVAL="0 */6 * * *"

# API key plans (required if API key feature is enabled)
API_FREE_LIMIT=100
API_STARTER_LIMIT=10000
API_PRO_LIMIT=100000
API_BUSINESS_LIMIT=1000000

# Admin emails (required for admin panel access)
ADMIN_EMAILS="admin@yourdomain.com"
